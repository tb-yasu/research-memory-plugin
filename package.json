{
  "name": "research-memory-plugin",
  "version": "0.1.0",
  "description": "Personal Literature Memory — turn papers you read into reusable, research-connected memory. A MulmoClaude runtime plugin.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.js",
      "default": "./dist/vue.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "dev": "vite build --watch",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "gui-chat-protocol": "^0.3.0",
    "vue": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/language-core": "^3.3.1",
    "eslint": "^9.0.0",
    "gui-chat-protocol": "^0.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.0.0",
    "vue": "^3.5.34",
    "vue-eslint-parser": "^10.0.0",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
